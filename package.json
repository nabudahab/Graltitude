{
  "name": "graltitude",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/web",
    "ride-lab": "node scripts/prepare-local.mjs && wrangler d1 migrations apply graltitude --local --config apps/api/wrangler.jsonc && wrangler dev --local --config apps/api/wrangler.jsonc --ip 127.0.0.1 --port 4176 --assets dist/ride-lab --var APP_URL:http://127.0.0.1:4176/",
    "build": "tsc -p tsconfig.json && vite build apps/web",
    "build:portable": "node scripts/build-portable.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "api:dev": "wrangler dev --config apps/api/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config apps/api/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.166.0"
  }
}
