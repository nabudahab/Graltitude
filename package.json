{
  "name": "graltitude",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/web",
    "build": "tsc -p tsconfig.json && vite build apps/web",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "api:dev": "wrangler dev --config apps/api/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config apps/api/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
